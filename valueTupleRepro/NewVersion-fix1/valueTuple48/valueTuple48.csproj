<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net4.8</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="System.ValueTuple" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libNet462\libNet462.csproj" />
  </ItemGroup>

  <Target Name="_removeValueTupleRedirect" AfterTargets="ResolveAssemblyReferences" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net471'))">
    <ItemGroup>
      <SuggestedBindingRedirects Remove="System.ValueTuple, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
    </ItemGroup>
  </Target>
</Project>
